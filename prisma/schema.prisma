// ThetaX Tech — database schema (MySQL / MariaDB on Hostinger)
// Every piece of public content lives here and is edited from /admin.
// JSON columns hold small structured lists (features, FAQs, process steps, gallery...).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────────── Auth ─────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(EDITOR)
  avatar             String?
  bio                String?   @db.Text
  mustChangePassword Boolean   @default(false)
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  resetTokenHash     String?
  resetTokenExpires  DateTime?
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  sessionVersion     Int       @default(0) // bump to invalidate all sessions
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  posts    Post[]
  activity ActivityLog[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // created | updated | deleted | published | login ...
  entity    String // Post | Service | Project ...
  entityId  String?
  label     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────── Services ───────────────────────────

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  icon             String   @default("sparkles") // lucide icon name
  tagline          String?
  shortDescription String   @db.Text
  longDescription  String?  @db.LongText // rich HTML
  // AEO: question-style heading + 40-60 word direct answer
  answerQuestion   String?
  answer           String?  @db.Text
  problem          String?  @db.Text
  solution         String?  @db.Text
  features         Json? // [{ title, description }]
  benefits         Json? // [{ title, description }]
  process          Json? // [{ title, description }]
  faqs             Json? // [{ question, answer }]
  image            String?
  accent           String? // optional per-service accent colour
  order            Int      @default(0)
  isVisible        Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  seoTitle         String?
  seoDescription   String?  @db.Text
  seoKeywords      String?  @db.Text
  ogImage          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projects Project[]

  @@index([order])
}

// ─────────────────────────── Portfolio ──────────────────────────

model Project {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  client         String?
  category       String
  industry       String?
  year           Int?
  summary        String    @db.Text
  description    String?   @db.LongText // rich HTML
  problem        String?   @db.Text
  solution       String?   @db.Text
  results        Json? // [{ label, value }]
  techStack      Json? // ["Next.js", ...]
  coverImage     String?
  gallery        Json? // ["/uploads/..."]
  liveUrl        String?
  isFeatured     Boolean   @default(false)
  isPublished    Boolean   @default(true)
  /// Concept/sample case study (not a real client project) — shows a "Sample" badge when enabled in Settings
  isSample       Boolean   @default(false)
  order          Int       @default(0)
  seoTitle       String?
  seoDescription String?   @db.Text
  ogImage        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  services Service[]

  @@index([category])
  @@index([order])
}

// ────────────────────────────── Blog ────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Post {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String     @db.Text
  content        String     @db.LongText // rich HTML from TipTap
  coverImage     String?
  coverAlt       String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  isFeatured     Boolean    @default(false)
  readingTime    Int        @default(1)
  views          Int        @default(0)
  authorId       String?
  author         User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           Tag[]
  seoTitle       String?
  seoDescription String?    @db.Text
  ogImage        String?
  schemaType     String     @default("BlogPosting")
  faqs           Json? // optional FAQ block → FAQPage schema
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  posts Post[]
}

// ───────────────────────── Page content ─────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  quote     String   @db.Text
  rating    Int      @default(5)
  avatar    String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?  @db.Text
  photo     String?
  linkedin  String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  group     String   @default("general") // home | general | bpo | pricing ...
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, order])
}

model ClientLogo {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  url       String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Free-form editable blocks per page (hero copy, stats, about story, spotlights...).
model PageSection {
  id        String   @id @default(cuid())
  page      String // home | about | contact ...
  key       String // hero | stats | story ...
  title     String?
  data      Json
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([page, key])
}

/// Per-route SEO overrides for static pages (dynamic content carries its own SEO fields).
model PageSeo {
  id          String   @id @default(cuid())
  path        String   @unique // "/", "/about", "/services" ...
  title       String?
  description String?  @db.Text
  ogImage     String?
  noIndex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────── Leads ────────────────────────────

enum LeadType {
  CONTACT
  QUOTE
  CAREER
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType   @default(CONTACT)
  status    LeadStatus @default(NEW)
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  timeline  String?
  subject   String?
  message   String     @db.Text
  notes     String?    @db.Text
  sourceUrl String?
  ip        String?
  userAgent String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

// ───────────────────────────── Media ────────────────────────────

model Media {
  id        String   @id @default(cuid())
  filename  String // stored file name (unique on disk)
  name      String // display name, renameable
  url       String
  alt       String?
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ──────────────────────────── Settings ──────────────────────────

/// Key/value store: "site", "contact", "social", "seo", "analytics", "smtp", "theme", "modules".
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ──────────────────────── Modules (add-ons) ─────────────────────

/// Careers module — enabled/disabled from Settings → Modules.
model Job {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  department  String?
  location    String   @default("Karachi, Pakistan")
  type        String   @default("Full-time") // Full-time | Part-time | Contract | Internship
  summary     String   @db.Text
  description String?  @db.LongText
  isOpen      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Newsletter module.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────────── AI Agent ─────────────────────────

/// One chat thread with the AI agent (website widget, WhatsApp or email).
model ChatConversation {
  id            String        @id @default(cuid())
  channel       String        @default("web") // web | whatsapp | email | form
  visitorId     String? // anonymous browser id or WhatsApp number
  name          String?
  email         String?
  phone         String?
  company       String?
  service       String?
  budget        String?
  status        String        @default("open") // open | lead | handoff | closed
  leadId        String?
  pageUrl       String?
  ip            String?
  userAgent     String?       @db.Text
  messageCount  Int           @default(0)
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages ChatMessage[]

  @@index([lastMessageAt])
  @@index([visitorId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | tool
  /// Exact API content blocks (replayed unchanged so the history stays append-only)
  content        Json
  /// Plain text for display / export
  text           String           @db.Text
  /// Portfolio cards shown with this message
  cards          Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
